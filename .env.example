# Environment variables template for Enfermagem HNSR
# Copy this file to .env in your hosting server environment (Hostinger/VPS)

# Production Environment Settings
NODE_ENV=production

# Node.js Port
PORT=3000

# Gemini API Key (keep this server-side only in Hostinger/Node.js)
GEMINI_API_KEY=your_gemini_api_key_here
